# Fly2Git Pro Backend — Production Environment Configuration Template
# Copy this file to your deployment secret manager or .env on the production server.
# NEVER commit .env to version control.
# Production security: Keep all secret keys, private keys, and webhook secrets strictly server-side.

# -----------------------------------------------------------------------------
# 1. Server & Network Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
FLY2GIT_ORIGIN=https://fly2git.com
ALLOWED_ORIGINS=https://fly2git.com,https://app.fly2git.com
FRONTEND_URL=chrome-extension://fly2git

# -----------------------------------------------------------------------------
# 2. Authentication & Session Secrets (HMAC-SHA256)
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate_a_secure_random_64_character_hex_string_here
ENTITLEMENT_SIGNING_SECRET=generate_another_secure_64_character_hex_string_here

# -----------------------------------------------------------------------------
# 3. Asymmetric Entitlement Verification (Ed25519)
# -----------------------------------------------------------------------------
# Generate keypair with:
# node -e "const { generateKeyPairSync } = require('crypto'); const { privateKey, publicKey } = generateKeyPairSync('ed25519'); console.log('PRIV:\n' + privateKey.export({ type: 'pkcs8', format: 'pem' })); console.log('PUB:\n' + publicKey.export({ type: 'spki', format: 'pem' }));"
ENTITLEMENT_KEY_ID=fly2git-ed25519-v1
ENTITLEMENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ENTITLEMENT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# -----------------------------------------------------------------------------
# 4. Payment Provider Configuration (Stripe)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe
# Production Stripe live credentials (obtain from Stripe Dashboard -> API Keys)
STRIPE_SECRET_KEY=sk_live_placeholder_set_in_production_secrets
STRIPE_WEBHOOK_SECRET=whsec_placeholder_set_in_production_secrets

# Stripe Price IDs for Pro subscription plans (Stripe Dashboard -> Products)
STRIPE_PRICE_MONTHLY=price_pro_monthly_live_id
STRIPE_PRICE_YEARLY=price_pro_yearly_live_id

# Backward-compatibility aliases
PAYMENT_PRICE_MONTHLY=price_pro_monthly_live_id
PAYMENT_PRICE_YEARLY=price_pro_yearly_live_id

# -----------------------------------------------------------------------------
# 5. Admin Access (Pro Grant Management — Phase 14)
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=generate_a_secure_admin_api_key_here

# -----------------------------------------------------------------------------
# 6. Database & Durability Configuration
# -----------------------------------------------------------------------------
# Path to persistent disk volume mount (e.g. Docker volume or Cloud persistent disk)
DATABASE_PATH=/data/fly2git_backend.json
DATABASE_URL=
