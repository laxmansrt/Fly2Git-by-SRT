{
  "manifest_version": 3,
  "name": "Fly2Git by SRT",
  "short_name": "Fly2Git",
  "version": "1.1.6",
  "description": "Automatically sync your accepted LeetCode, GeeksforGeeks, HackerRank, and CodeChef solutions to GitHub — with repository-level permissions, not account-wide access.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://www.hackerrank.com/*",
    "https://www.codechef.com/*",
    "https://atcoder.jp/*",
    "https://codeforces.com/*",
    "https://www.spoj.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://api.fly2git.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "sync-notification.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.geeksforgeeks.org/problems/*"
      ],
      "js": [
        "gfg-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.geeksforgeeks.org/problems/*"
      ],
      "js": [
        "sync-notification.js",
        "gfg-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hackerrank.com/challenges/*",
        "https://www.hackerrank.com/contests/*/challenges/*"
      ],
      "js": [
        "hackerrank-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.hackerrank.com/challenges/*",
        "https://www.hackerrank.com/contests/*/challenges/*"
      ],
      "js": [
        "sync-notification.js",
        "hackerrank-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.codechef.com/*"
      ],
      "js": [
        "codechef-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.codechef.com/*"
      ],
      "js": [
        "sync-notification.js",
        "codechef-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://atcoder.jp/*"
      ],
      "js": [
        "atcoder-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://atcoder.jp/*"
      ],
      "js": [
        "sync-notification.js",
        "atcoder-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/*"
      ],
      "js": [
        "codeforces-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/*"
      ],
      "js": [
        "sync-notification.js",
        "codeforces-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.spoj.com/*"
      ],
      "js": [
        "spoj-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.spoj.com/*"
      ],
      "js": [
        "sync-notification.js",
        "spoj-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
